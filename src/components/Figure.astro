---
// 본문 이미지 + 캡션. MDX에서 이미지를 import해 넘긴다.
//   import tabletMain from './tablet-main.png';
//   <Figure src={tabletMain} alt="태블릿 메인 화면" caption="체험 중 메인 화면" />
import type { ImageMetadata } from 'astro';
import { Image } from 'astro:assets';

interface Props {
	src: ImageMetadata;
	alt: string;
	caption?: string;
	// 세로로 긴 화면(폰·세로 태블릿)은 폭을 줄여 가운데 둔다
	narrow?: boolean;
}

const { src, alt, caption, narrow = false } = Astro.props;
---

<figure class:list={['figure', { narrow }]}>
	<Image src={src} alt={alt} width={1520} />
	{caption && <figcaption>{caption}</figcaption>}
</figure>

<style>
	.figure {
		margin: 2rem 0;
	}
	.narrow {
		max-width: 420px;
		margin-inline: auto;
	}
	.figure :global(img) {
		display: block;
		width: 100%;
		border: 1px solid var(--border);
	}
	figcaption {
		margin-top: 0.6rem;
		color: var(--text-muted);
		font-size: 0.88rem;
		text-align: center;
	}
</style>
