---
// 본문 영상 + 캡션. 두 가지 방식 중 하나를 쓴다.
//   1) 짧은 클립(수 MB): 글 폴더에 mp4를 두고 import해 src로 넘긴다
//        import demo from './exhibition-demo.mp4';
//        <Video src={demo} poster={demoPoster} caption="..." />
//      clip을 주면 GIF처럼 소리 없이 자동 반복 재생한다
//   2) 긴 영상: YouTube에 올리고 id만 넘긴다
//        <Video youtube="dQw4w9WgXcQ" caption="..." />
import type { ImageMetadata } from 'astro';
import { getImage } from 'astro:assets';

interface Props {
	src?: string;
	youtube?: string;
	poster?: ImageMetadata;
	caption?: string;
	// 짧은 무음 루프 클립
	clip?: boolean;
	// 세로 영상
	portrait?: boolean;
	title?: string;
}

const { src, youtube, poster, caption, clip = false, portrait = false, title = '' } = Astro.props;
if (!src && !youtube) throw new Error('Video: src 또는 youtube 중 하나가 필요합니다');
const posterUrl = poster ? (await getImage({ src: poster, width: 1520 })).src : undefined;
---

<figure class:list={['video', { portrait }]}>
	{
		youtube ? (
			<div class="frame">
				<iframe
					src={`https://www.youtube-nocookie.com/embed/${youtube}`}
					title={title || caption || '영상'}
					loading="lazy"
					allow="accelerometer; encrypted-media; gyroscope; picture-in-picture"
					allowfullscreen
				/>
			</div>
		) : clip ? (
			<video src={src} poster={posterUrl} autoplay muted loop playsinline preload="metadata" />
		) : (
			<video src={src} poster={posterUrl} controls playsinline preload="metadata" />
		)
	}
	{caption && <figcaption>{caption}</figcaption>}
</figure>

<style>
	.video {
		margin: 2rem 0;
	}
	.portrait {
		max-width: 420px;
		margin-inline: auto;
	}
	video,
	.frame {
		display: block;
		width: 100%;
		border: 1px solid var(--border);
		border-radius: var(--radius);
		background: var(--bg-subtle);
		overflow: hidden;
	}
	.frame {
		aspect-ratio: 16 / 9;
	}
	.portrait .frame {
		aspect-ratio: 9 / 16;
	}
	iframe {
		width: 100%;
		height: 100%;
		border: 0;
	}
	figcaption {
		margin-top: 0.6rem;
		color: var(--text-muted);
		font-size: 0.88rem;
		text-align: center;
	}
</style>
