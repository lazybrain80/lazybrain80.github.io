---
import type { CollectionEntry } from 'astro:content';
import FormattedDate from './FormattedDate.astro';

interface Props {
	posts: CollectionEntry<'blog'>[];
	// draft 글을 링크 없이 '준비 중'으로 보여 준다 (draft가 섞여 오는 연재 목록용)
	pendingDrafts?: boolean;
}

const { posts, pendingDrafts = false } = Astro.props;
---

{
	posts.length === 0 ? (
		<p class="empty">아직 작성된 글이 없습니다.</p>
	) : (
		<ul>
			{posts.map((post) =>
				pendingDrafts && post.data.draft ? (
					<li class="pending">
						<div>
							<span class="title">{post.data.title}</span>
							<span class="desc">{post.data.description}</span>
						</div>
						<span class="badge">준비 중</span>
					</li>
				) : (
					<li>
						<a href={`/blog/${post.id}/`}>
							<span class="title">{post.data.title}</span>
							<span class="desc">{post.data.description}</span>
						</a>
						<FormattedDate date={post.data.pubDate} />
					</li>
				),
			)}
		</ul>
	)
}

<style>
	ul {
		margin: 0;
		padding: 0;
		list-style: none;
	}
	li {
		display: flex;
		justify-content: space-between;
		align-items: baseline;
		gap: 1.5rem;
		padding: 1rem 0;
		border-bottom: 1px solid var(--border);
	}
	a,
	.pending div {
		display: flex;
		flex-direction: column;
		color: inherit;
		text-decoration: none;
	}
	a:hover .title {
		color: var(--accent);
	}
	.title {
		font-weight: 600;
	}
	.desc {
		color: var(--text-muted);
		font-size: 0.92rem;
	}
	.pending {
		opacity: 0.7;
	}
	time,
	.badge {
		flex-shrink: 0;
		color: var(--text-muted);
		font-size: 0.85rem;
	}
	@media (max-width: 640px) {
		li {
			flex-direction: column;
			gap: 0.25rem;
		}
	}
</style>
