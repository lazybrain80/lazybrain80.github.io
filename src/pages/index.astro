---
import PostList from '../components/PostList.astro';
import ProjectCard from '../components/ProjectCard.astro';
import SocialLinks from '../components/SocialLinks.astro';
import { profile, SITE_DESCRIPTION, SITE_TITLE } from '../data/profile';
import BaseLayout from '../layouts/BaseLayout.astro';
import { getPosts, getProjects } from '../lib/content';

const projects = await getProjects();
const featured = projects.filter((p) => p.data.featured);
const shownProjects = (featured.length > 0 ? featured : projects).slice(0, 4);
const recentPosts = (await getPosts()).slice(0, 5);
---

<BaseLayout title={SITE_TITLE} description={SITE_DESCRIPTION}>
	<section class="hero">
		<h1>{profile.name}</h1>
		<p class="headline">{profile.headline}</p>
		<p>{profile.intro}</p>
		<SocialLinks />
	</section>

	<h2 class="section-title">Projects</h2>
	{
		shownProjects.length === 0 ? (
			<p class="empty">곧 프로젝트가 추가됩니다.</p>
		) : (
			<div class="grid">
				{shownProjects.map((project) => (
					<ProjectCard project={project} />
				))}
			</div>
		)
	}
	{projects.length > shownProjects.length && <p class="more"><a href="/projects/">모든 프로젝트 보기 →</a></p>}

	<h2 class="section-title">Recent Posts</h2>
	<PostList posts={recentPosts} />
	{recentPosts.length > 0 && <p class="more"><a href="/blog/">모든 글 보기 →</a></p>}
</BaseLayout>

<style>
	.hero {
		padding: 1rem 0 0.5rem;
	}
	.hero h1 {
		margin-bottom: 0.2rem;
	}
	.headline {
		margin-bottom: 1rem;
		color: var(--accent);
		font-size: 1.15rem;
		font-weight: 600;
	}
	.grid {
		display: grid;
		gap: 1rem;
	}
	.more {
		margin-top: 1rem;
		text-align: right;
		font-size: 0.92rem;
	}
</style>
