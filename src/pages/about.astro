---
import SocialLinks from '../components/SocialLinks.astro';
import Tags from '../components/Tags.astro';
import { experience, profile, skills } from '../data/profile';
import BaseLayout from '../layouts/BaseLayout.astro';
import { formatPeriod, getProjects } from '../lib/content';

const projects = await getProjects();
const projectsOf = (company: string) =>
	projects.filter((p) => p.data.kind === 'work' && p.data.company === company);
---

<BaseLayout title="About" description={`${profile.name} — ${profile.headline}. 경력과 기술 스택`}>
	<h1>{profile.name}</h1>
	<p class="headline">{profile.headline}</p>
	<p>{profile.intro}</p>
	<SocialLinks />

	<h2 class="section-title">Experience</h2>
	{
		experience.length === 0 ? (
			<p class="empty">경력 정보는 src/data/profile.ts 에 추가합니다.</p>
		) : (
			<ol class="timeline">
				{experience.map((job) => (
					<li>
						<div class="job-head">
							<h3>{job.company}</h3>
							<span class="muted">{formatPeriod(job.start, job.end)}</span>
						</div>
						<p class="role">{job.role}</p>
						<p>{job.summary}</p>
						{job.highlights.length > 0 && (
							<ul>
								{job.highlights.map((h) => (
									<li>{h}</li>
								))}
							</ul>
						)}
						{projectsOf(job.company).length > 0 && (
							<p class="related">
								관련 프로젝트:{' '}
								{projectsOf(job.company).map((p, i) => (
									<>
										{i > 0 && ', '}
										<a href={`/projects/${p.id}/`}>{p.data.title}</a>
									</>
								))}
							</p>
						)}
						<Tags items={job.stack} />
					</li>
				))}
			</ol>
		)
	}

	{
		skills.length > 0 && (
			<>
				<h2 class="section-title">Skills</h2>
				<dl class="skills">
					{skills.map((group) => (
						<>
							<dt>{group.category}</dt>
							<dd>
								<Tags items={group.items} />
							</dd>
						</>
					))}
				</dl>
			</>
		)
	}
</BaseLayout>

<style>
	.headline {
		margin-bottom: 1rem;
		color: var(--accent);
		font-size: 1.15rem;
		font-weight: 600;
	}
	.timeline {
		margin: 0;
		padding: 0;
		list-style: none;
	}
	.timeline > li {
		position: relative;
		padding: 0 0 2rem 1.5rem;
		border-left: 2px solid var(--border);
	}
	.timeline > li::before {
		content: '';
		position: absolute;
		left: -7px;
		top: 0.55rem;
		width: 12px;
		height: 12px;
		border-radius: 50%;
		background: var(--accent);
	}
	.job-head {
		display: flex;
		flex-wrap: wrap;
		justify-content: space-between;
		align-items: baseline;
		gap: 0.5rem;
	}
	.job-head h3 {
		margin: 0;
	}
	.job-head span {
		font-size: 0.9rem;
	}
	.role {
		margin-bottom: 0.5rem;
		color: var(--text-muted);
		font-weight: 600;
	}
	.related {
		font-size: 0.92rem;
	}
	.skills {
		display: grid;
		grid-template-columns: max-content 1fr;
		gap: 0.75rem 1.5rem;
		margin: 0;
	}
	.skills dt {
		font-weight: 600;
	}
	.skills dd {
		margin: 0;
	}
	@media (max-width: 640px) {
		.skills {
			grid-template-columns: 1fr;
			gap: 0.3rem;
		}
		.skills dd {
			margin-bottom: 0.75rem;
		}
	}
</style>
